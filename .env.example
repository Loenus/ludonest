# Copy to .env.local and fill in from your Supabase project settings.

# Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Project → Settings → API → service_role (SECRET — server only, never expose)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: canonical site URL used to build OAuth redirect URLs.
# Defaults to the request host when unset (fine for local dev).
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
